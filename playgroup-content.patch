+  it("every activity across every Playgroup booklet has an id, title, and valid quarter", () => {
+    const playgroup = KITS.find(k => k.id === "playgroup");
+    let total = 0;
+    for (const booklet of playgroup.booklets) {
+      if (!booklet.unlocked) continue;
+      for (const a of booklet.activities) {
+        total++;
+        expect(a.id).toBeTruthy();
+        expect(a.title).toBeTruthy();
+        expect([1, 2, 3, 4]).toContain(a.quarter);
+        expect(a.materials.length).toBeGreaterThan(0);
+        expect(a.steps.length).toBeGreaterThan(0);
+      }
+    }
+    expect(total).toBe(77);
+  });
+
+  it("no duplicate activity or booklet ids across the whole Playgroup kit, and none collide with Nursery's", () => {
+    const playgroup = KITS.find(k => k.id === "playgroup");
+    const nursery = KITS.find(k => k.id === "nursery");
+    const nurseryIds = new Set();
+    for (const booklet of nursery.booklets) {
+      if (!booklet.unlocked) continue;
+      nurseryIds.add(booklet.id);
+      for (const a of booklet.activities) nurseryIds.add(a.id);
+    }
+
+    const ids = [];
+    const bookletIds = [];
+    for (const booklet of playgroup.booklets) {
+      if (!booklet.unlocked) continue;
+      bookletIds.push(booklet.id);
+      expect(nurseryIds.has(booklet.id)).toBe(false);
+      for (const a of booklet.activities) {
+        ids.push(a.id);
+        expect(nurseryIds.has(a.id)).toBe(false);
+      }
+    }
+    expect(new Set(ids).size).toBe(ids.length);
+    expect(new Set(bookletIds).size).toBe(bookletIds.length);
+    expect(bookletIds.length).toBe(17);
+  });
 });
 
