# Copy this file to .env.local (which is gitignored) and fill in real values
# from your Supabase project's Settings → API page.

# Used by the browser app (src/lib/supabaseClient.js). Safe to expose --
# protected by Row Level Security, not secret. Must be prefixed VITE_ so
# Vite includes it in the client bundle.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Used ONLY by api/admin/create-user.js (a server-side function). This key
# has full database access and bypasses Row Level Security entirely.
# NEVER add a VITE_ prefix to this one — that would bundle it into
# client-side JavaScript and hand out full database access to anyone who
# opens the browser console. Find it on the same Settings → API page, under
# "service_role" (marked secret).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
